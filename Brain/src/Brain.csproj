<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- TODO: bottlenecked by unity monobehavior, update on CoreCLR -->
    <TargetFrameworks>net10.0;netstandard2.1</TargetFrameworks>
    <!-- ImplicitUsings generates a file inside obj/ that unity never sees
         which could create dependency mismatches -->
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>12</LangVersion>
  </PropertyGroup>

  <Target Name="CopyToUnity" AfterTargets="Build" Condition="'$(TargetFramework)' == 'netstandard2.1'">
    <Copy SourceFiles="$(TargetPath);$(TargetDir)$(TargetName).pdb"
          DestinationFolder="$(MSBuildProjectDirectory)\..\..\Electrode\Assets\Plugins\Brain" />
  </Target>

</Project>
