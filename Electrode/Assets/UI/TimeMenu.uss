.time-menu {
    width: 100%;
    max-width: 256px;
    height: 100%;
    padding: 4px 0;

    flex-direction: row;
    align-items: center;
}

.time-menu .unity-float-field {
    width: 64px;
    height: 100%;
    flex-shrink: 0;
}

.time-menu .unity-float-field .unity-base-text-field__input {
    flex-grow: 1;
}

.time-menu .slider {
    flex-grow: 1;
    margin: 0;
}

.time-menu .unity-base-slider__drag-container {
    justify-content: center; /* keep dragger vertically center on slider */
}

.time-menu .unity-base-slider__dragger {
    --d: 16px;

    width: var(--d);
    height: var(--d);
    top: auto;

    border-radius: 50%;
}
