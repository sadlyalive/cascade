:root {
    color: var(--bright);
    -unity-font-definition: url("project://database/Assets/UI/Fonts/Montserrat-Regular.ttf");
}

.unity-label {
    padding: 0;
    margin: 0;
}

.unity-base-field {
    padding: 0;
    margin: 0;
    justify-content: space-between;
}

.unity-base-field__label {
    min-width: auto;
    width: auto;
}

.unity-base-field__label {
    margin-right: var(--row-pad);
    flex-shrink: 0;
    -unity-text-align: middle-left;
}

.unity-base-text-field__input {
    padding: 4px;
    flex-grow: 0;
    background-color: var(--dark);
}

.unity-popup-field {
    width: 512px;
}

.unity-toggle__checkmark {
    background-color: var(--bright);
}

.unity-toggle__input,
.unity-toggle__checkmark {
    border-radius: 4px;
}

.unity-base-field:focus .unity-label {
    color: var(--bright);
}

.unity-base-slider__tracker {
    color: var(--bright);
    background-color: var(--dark);
    border-radius: 3px;
}

.unity-base-slider__dragger {
    background-color: var(--bright);
}

.unity-enum-field__input {
    width: 128px;
    margin: 0;
    padding: 4px 4px;

    color: var(--dark);
    background-color: var(--bright);
    border-radius: 4px;
}

.singleton {
    width: auto;
    height: 100%;

    padding: 4px 0;
}

.row-spacer {
    margin: 0 var(--row-pad) 0 0;
}

.hidden {
    display: none;
}

.topbar {
    width: 100%;
    height: 32px;
    padding: 0 0 0 var(--row-pad);
    flex-direction: row;
    align-items: flex-start;
    justify-content: flex-start;
    background-color: var(--bg);
}

/* transparent strip along the bottom edge. absolute so it never pushes the inspector, and picking-mode="Ignore" in the
 * uxml so clicks pass through to the scene */
.status-bar {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    padding: 4px var(--row-pad);
    flex-direction: column-reverse;

    -unity-font-definition: url("project://database/Assets/UI/Fonts/DMMono-Light.ttf");
    font-size: 12px;
}

/* soft shadow keeps the text legible over similar colors since there's no background */
.status-bar .unity-label {
    text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.7);
}

.drag-box {
    position: absolute;
    background-color: rgba(64, 64, 256, 0.25);
}