# unity regenerates all of this from Assets/, Packages/, and ProjectSettings/
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Mm]emoryCaptures/
[Rr]ecordings/
[Uu]ser[Ss]ettings/

# Auto-generated per-IDE project/solution files. Unity rewrites these itself
# from the Assets folder every time the editor opens; hand edits don't survive.
*.csproj
*.sln
*.slnx
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Crash/build byproducts
sysinfo.txt
crashlytics-build.properties
*.apk
*.aab
*.unitypackage
*.app

# root .gitignore has a NuGet rule ("**/[Pp]ackages/*") that would
# otherwise also swallow the unity Packages/ folder
!Packages/manifest.json
!Packages/packages-lock.json

# root .gitignore has a blanket "*.meta" rule meant for an unrelated VS
# convention. it matches unity metadata files which unity uses to map scripts
# to components persistently
!*.meta
!**/*.meta

# exclude directory link to brain lib so it doesn't get committed twice
Assets/Brain/

# ai and package metadata
ProjectSettings/AI.Assistant/
ProjectSettings/Packages/

# unity ui toolkit intellisense assist cache
UIElementsSchema/

# include rider project-specific settings
!*.sln.DotSettings

# unity recovery files (includes meta folders)
**/Assets/_Recovery*
